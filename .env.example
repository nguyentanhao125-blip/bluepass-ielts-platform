# ============================================================================
# BluePass English Objective Testing & Practice Platform - Environment Config
# Copy this file to `.env` for local development or VPS Docker deployment
# ============================================================================

# --- PostgreSQL 16 Database Configuration ---
POSTGRES_USER=bluepass_admin
POSTGRES_PASSWORD=BluePass_Secure_2026!
POSTGRES_DB=bluepass_exam_db
POSTGRES_PORT=5432

# Prisma Connection String (use `localhost` on host machine, `db` inside Docker)
DATABASE_URL="postgresql://bluepass_admin:BluePass_Secure_2026!@localhost:5432/bluepass_exam_db?schema=public"

# --- pgAdmin 4 Web GUI (Multi-Admin Team Management) ---
# Access at http://YOUR_VPS_IP:5050
# Additional team members can be added in pgAdmin -> User Management
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@bluepass.edu.vn
PGADMIN_DEFAULT_PASSWORD=AdminPg_2026!

# --- Next.js & NextAuth v5 Security Configuration ---
APP_PORT=3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bluepass_super_secret_jwt_signing_key_2026_vps_production"

# Optional Google OAuth (for Student 1-Click Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Hybrid AI Chatbot Configuration (Optional External LLM Keys) ---
# Built-in BluePass Knowledge Base AI responds automatically out-of-the-box.
# Provide GEMINI_API_KEY or OPENAI_API_KEY to enable live generative LLM responses.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Rate Limiting & Anti-Cheat Settings ---
RATE_LIMIT_AUTH_MAX_PER_MIN=10
RATE_LIMIT_SUBMIT_MAX_PER_MIN=5
EXAM_SUBMISSION_GRACE_SECONDS=30
